{
  "name": "fab-sealed-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulate opening 8 Usurp the Shadow Throne booster packs and build a 30-card sealed deck.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-cards": "node scripts/fetch-cards.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@flesh-and-blood/cards": "^5.0.26",
    "@flesh-and-blood/types": "^5.0.26",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
